{
  "openapi": "3.0.0",
  "info": {
    "title": "社内つぶやきボード REST API",
    "description": "社内つぶやきボードの投稿データを取得・連携するためのAPI仕様書。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "ローカル開発サーバー"
    }
  ],
  "paths": {
    "/api/posts": {
      "get": {
        "summary": "投稿一覧の取得",
        "description": "投稿データを新着順で取得します。パラメータ指定により、論理削除済みやゴミ箱から完全削除されたデータも含めて取得可能です。",
        "parameters": [
          {
            "name": "all",
            "in": "query",
            "description": "trueを指定した場合、削除済み（ゴミ箱）および完全削除された投稿もすべて含めて返却します。未指定の場合は有効な投稿のみ取得します。",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "正常に投稿一覧を取得しました。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PostResponse"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PostResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "投稿ID"
          },
          "author": {
            "type": "string",
            "description": "投稿者名"
          },
          "body": {
            "type": "string",
            "description": "投稿本文"
          },
          "color": {
            "type": "string",
            "description": "アバター色を表すHEXカラーコード（例: #3B82F6）"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "投稿作成日時（ISO-8601形式）"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "関連するタグ名のリスト"
          },
          "deleteStatus": {
            "type": "integer",
            "description": "削除ステータス（0: 有効, 1: 論理削除済み/ゴミ箱, 2: 完全削除済み）"
          },
          "deletedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "論理削除日時（未削除の場合は null）"
          },
          "purgedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "ゴミ箱から完全削除された日時（完全削除されていない場合は null）"
          }
        }
      }
    }
  }
}
